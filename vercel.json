{
  "version": 2,
  "regions": ["sin1"],
  "functions": {
    "api/index.js": {
      "includeFiles": "src/routes/**",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.js"
    }
  ],
  "crons": [
    {
      "path": "/api/v1/cron/fill",
      "schedule": "0 19 * * *"
    }
  ]
}
