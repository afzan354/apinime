# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (MySQL / TiDB Cloud Serverless / Aiven / Remote MySQL)
# Jika dideploy ke Vercel, gunakan koneksi database cloud (misal: TiDB Cloud atau Aiven)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=anichin_api
# Set true jika database cloud Anda memerlukan koneksi aman SSL (seperti TiDB Cloud)
DB_SSL=false

# Sumber Scraper (Anichin)
SOURCE_BASE_URL=https://anichin.moe
SCRAPER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36
SCRAPER_TIMEOUT=8000

# Cloudflare Worker Proxy (Solusi 2 untuk bypass blokir Cloudflare 403 di Vercel)
# Masukkan URL worker setelah dideploy ke dash.cloudflare.com
# PROXY_URL=https://anichin-proxy.yourname.workers.dev
# PROXY_SECRET=your_optional_secret_here
